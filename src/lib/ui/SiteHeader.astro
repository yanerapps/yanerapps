---
import UiIcon from './UiIcon.astro';
import { cleanPath } from '../paths';

interface Props {
  /** The brand's own page; the brand links back to it, or to the top when you are on it. */
  home: string;
  name: string;
  links: { href: string; label: string }[];
}

const { home: homePath, name, links } = Astro.props;
const here = cleanPath(Astro.url.pathname);
const home = here === homePath;
---

<a class="skip-link" href="#main">Skip to content</a>
<header class="header" data-header>
  <div class="header-inner page">
    <a class="brand" href={home ? '#top' : homePath} aria-label={home ? `${name}, back to top` : `${name} home`}>
      <slot name="mark" />
      <span>{name}</span>
    </a>
    <nav class="desktop-nav" aria-label="Site">
      <ul>
        {
          links.map((l) => (
            <li>
              <a href={l.href} aria-current={l.href === here ? 'page' : undefined}>{l.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <button
      class="theme-toggle"
      type="button"
      data-theme-toggle
      aria-label="Dark mode"
      aria-pressed="false"
      title="Switch to dark mode"
    >
      <span class="theme-moon"><UiIcon name="moon" size={17} /></span>
      <span class="theme-sun"><UiIcon name="sun" size={17} /></span>
    </button>
    <button
      class="mobile-menu-btn"
      type="button"
      data-mobile-trigger
      popovertarget="mobile-site-nav"
      popovertargetaction="toggle"
      aria-controls="mobile-site-nav"
      aria-expanded="false"
    >
      <span class="menu-open-icon"><UiIcon name="menu" size={20} /></span>
      <span class="menu-close-icon"><UiIcon name="close" size={20} /></span>
      <span>Menu</span>
    </button>
    <nav id="mobile-site-nav" class="mobile-nav" data-mobile-menu aria-label="Mobile site" popover="auto">
      <ul>
        <li><a href={homePath} aria-current={home ? 'page' : undefined}>Home</a></li>
        {
          links.map((l) => (
            <li>
              <a href={l.href} aria-current={l.href === here ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  import './theme-ui';
  const header = document.querySelector('[data-header]') as HTMLElement;
  const update = () => header.toggleAttribute('data-scrolled', window.scrollY > 24);
  addEventListener('scroll', update, { passive: true });
  update();

  const menu = document.querySelector('[data-mobile-menu]') as HTMLElement;
  const trigger = document.querySelector('[data-mobile-trigger]') as HTMLButtonElement;
  const mobile = matchMedia('(max-width: 860px)');
  menu.addEventListener('toggle', () => {
    trigger.setAttribute('aria-expanded', String(menu.matches(':popover-open')));
  });
  menu.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => menu.hidePopover());
  });
  mobile.addEventListener('change', () => {
    if (!mobile.matches && menu.matches(':popover-open')) {
      const focusInside = menu.contains(document.activeElement);
      menu.hidePopover();
      if (focusInside) header.querySelector<HTMLAnchorElement>('.brand')?.focus();
    }
  });
</script>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    height: var(--header-h);
    border-bottom: 1px solid transparent;
    transition:
      background-color 0.25s ease,
      border-color 0.25s ease;
  }

  .header[data-scrolled] {
    background: color-mix(in srgb, var(--bg) 72%, transparent);
    border-bottom-color: var(--line);
    backdrop-filter: saturate(160%) blur(16px);
    -webkit-backdrop-filter: saturate(160%) blur(16px);
  }

  .header-inner {
    height: 100%;
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: var(--text);
    text-decoration: none;
    font-weight: 650;
    font-size: 15px;
    white-space: nowrap;
    flex: none;
  }

  .brand :global(.app-icon) {
    border-radius: 6px;
  }

  .desktop-nav ul {
    display: flex;
    gap: 22px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .desktop-nav a {
    color: var(--muted);
    font-size: 14px;
    text-decoration: none;
    transition: color 0.2s;
  }

  .desktop-nav a:hover,
  .desktop-nav a[aria-current='page'] {
    color: var(--text);
  }

  .theme-toggle {
    display: grid;
    place-items: center;
    flex: none;
    margin-left: auto;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 1px solid var(--line-2);
    border-radius: 9px;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
  }

  .theme-toggle:hover { color: var(--text); }
  .theme-sun { display: none; }
  :global([data-theme='dark']) .theme-sun { display: block; }
  :global([data-theme='dark']) .theme-moon { display: none; }
  :global(html:not(.js)) .theme-toggle { display: none; }
  :global(html:not(.js)) .mobile-menu-btn { margin-inline-start: auto; }


  .mobile-menu-btn {
    display: none;
    flex: none;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    min-height: 2.25rem;
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--line-2);
    border-radius: 9px;
    background: transparent;
    color: var(--text);
    font-size: 13px;
    line-height: 1.25;
    cursor: pointer;
    anchor-name: --mobile-menu-btn;
  }
  .menu-close-icon { display: none; }
  .header:has(#mobile-site-nav:popover-open) .menu-open-icon { display: none; }
  .header:has(#mobile-site-nav:popover-open) .menu-close-icon { display: block; }
  .header:has(#mobile-site-nav:popover-open) .mobile-menu-btn { background: var(--panel-2); }
  .mobile-nav {
    position: fixed;
    inset: auto;
    inset-block-start: calc(var(--header-h) + 0.5rem);
    inset-block-start: anchor(--mobile-menu-btn bottom);
    inset-inline: var(--gutter);
    width: auto;
    max-height: calc(100dvh - var(--header-h) - 1.5rem);
    margin: 0.5rem 0 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 0.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--panel);
    box-shadow: var(--shadow);
  }
  .mobile-nav ul {
    display: grid;
    gap: 2px;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .mobile-nav li a {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.5rem 0.875rem;
    border-radius: 10px;
    color: var(--text);
    font-size: 15px;
    text-decoration: none;
  }
  .mobile-nav li a:hover {
    background: var(--panel-2);
  }
  .mobile-nav li a[aria-current='page'] {
    background: var(--panel-2);
    font-weight: 650;
  }

  @media (max-width: 860px) {
    .header-inner { gap: 10px; }
    .desktop-nav {
      display: none;
    }

    .mobile-menu-btn { display: inline-flex; }
  }
</style>
