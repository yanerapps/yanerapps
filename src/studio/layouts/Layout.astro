---
import '@fontsource-variable/instrument-sans/wdth.css';
import '@fontsource-variable/newsreader';
import '@fontsource-variable/newsreader/wght-italic.css';
import '../styles/global.css';

import SeoHead from '../../lib/SeoHead.astro';
import ThemeBoot from '../../lib/ThemeBoot.astro';
import { cleanPath } from '../../lib/paths';
import { appIds, appPaths } from '../../apps/registry';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Yaner Apps — We make quality apps.',
  description = 'Yaner Apps makes quality apps. Maker of GPS-Go, a no-root location simulator.',
} = Astro.props;

const currentPath = cleanPath(Astro.url.pathname);
// Support follows the app whose pages you are on; site-wide pages keep GPS-Go's.
const app = appIds.find((id) => currentPath.startsWith(`/${id}/`)) ?? 'gps-go';
const support = appPaths(app).support;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SeoHead
      title={title}
      description={description}
      image="/og.png"
      imageSize={{ width: 1200, height: 630 }}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f4f1ea" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0e0d0b" />
    <ThemeBoot />
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="site">
      <div class="wrap">
        <a class="brand-container" href="/" aria-label="Yaner Apps home">
          <span class="brand-name">Yaner Apps</span>
        </a>
        <nav class="site-nav" aria-label="Site navigation">
          <a href="/privacy" aria-current={currentPath.endsWith('/privacy') ? 'page' : undefined}>Privacy</a>
          <a href={support} aria-current={currentPath.endsWith('/support') ? 'page' : undefined}>Support</a>
          <button class="theme-toggle" type="button" data-theme-toggle aria-label="Toggle dark mode">
            <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
              <circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="1.5" />
              <path d="M8 1.5a6.5 6.5 0 0 1 0 13z" fill="currentColor" />
            </svg>
          </button>
        </nav>
      </div>
    </header>

    <main class="wrap" id="main">
      <slot />
    </main>

    <footer class="site">
      <div class="wrap">
        <span><span class="motto">Ride the Wind</span> &middot; &copy; 2026 Yaner Apps</span>
        <div class="footer-links">
          <a href="/">Home</a>
          <a href="/privacy">Privacy Policy</a>
          <a href={support}>Support</a>
        </div>
        <p class="colophon">
          Static site · No tracking · Self-hosted fonts · Swallow drawn in code
        </p>
      </div>
    </footer>

    <script>
      import { initTheme } from '../../lib/theme';
      initTheme();
    </script>

    <!-- Long documents get a table of contents built from their h2s; CSS shows it only where the margin is wide -->
    <script is:inline>
      (function () {
        function toc() {
          const prose = document.querySelector('.prose');
          const heads = prose ? prose.querySelectorAll('h2') : [];
          if (heads.length < 4) return;
          const nav = document.createElement('nav');
          nav.className = 'toc';
          nav.setAttribute('aria-label', 'Contents');
          heads.forEach(function (h) {
            const text = h.textContent.replace(/^\d+\.\s*/, '').trim();
            if (!h.id) h.id = text.toLowerCase().replace(/[^\p{L}\p{N}]+/gu, '-').replace(/^-|-$/g, '');
            const a = document.createElement('a');
            a.href = '#' + h.id;
            a.textContent = text;
            nav.appendChild(a);
          });
          const rail = document.createElement('div');
          rail.className = 'toc-rail';
          rail.appendChild(nav);
          prose.prepend(rail);
        }
        toc();
      })();
    </script>

    <!-- Scroll reveal -->
    <script is:inline>
      (function () {
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        function reveal() {
          const items = document.querySelectorAll('.reveal:not(.is-visible)');
          if (reduced || !('IntersectionObserver' in window)) {
            items.forEach(function (el) {
              el.classList.add('is-visible');
            });
            return;
          }
          let seen = 0;
          const io = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (entry) {
                if (!entry.isIntersecting) return;
                const el = entry.target;
                el.style.transitionDelay = Math.min(seen++ % 4, 3) * 60 + 'ms';
                el.classList.add('is-visible');
                io.unobserve(el);
              });
            },
            { rootMargin: '999% 0px -6% 0px', threshold: 0.05 }
          );
          items.forEach(function (el) {
            io.observe(el);
          });
        }
        reveal();
      })();
    </script>
  </body>
</html>
