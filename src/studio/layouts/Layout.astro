---
import '@fontsource-variable/instrument-sans/wdth.css';
import '@fontsource-variable/newsreader';
import '@fontsource-variable/newsreader/wght-italic.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
  lang?: string;
}

const {
  title = 'Yaner Apps — We make quality apps.',
  description = 'Yaner Apps makes quality apps. Maker of GPS-Go, a no-root location simulator.',
  currentPath = '/',
  lang = 'en',
} = Astro.props;

const zh = lang.startsWith('zh');
// Every page has a counterpart: /x <-> /zh-hans/x, with the English page at the unprefixed path.
const enPath = zh ? currentPath.replace(/^\/zh-hans/, '') || '/' : currentPath;
const zhPath = enPath === '/' ? '/zh-hans' : '/zh-hans' + enPath;
const local = (path: string) => (zh ? (path === '/' ? '/zh-hans' : '/zh-hans' + path) : path);
const home = local('/');
const privacy = local('/privacy');
// Support follows the app whose pages you are on; site-wide pages keep GPS-Go's.
const app = enPath.match(/^\/(pingdeck|gps-go)\//)?.[1] ?? 'gps-go';
const support = local(`/${app}/support`);
const site = Astro.site || 'https://yanerapps.com';
const canonicalUrl = new URL(currentPath, site).href;
const enUrl = new URL(enPath, site).href;
const zhUrl = new URL(zhPath, site).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f4f1ea" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0e0d0b" />

    <!-- Open Graph / Social Meta -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content="https://yanerapps.com/og.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="zh-Hans" href={zhUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    <script is:inline>
      (function () {
        const d = document.documentElement;
        d.classList.add('js');
        try {
          const t = localStorage.getItem('theme');
          if (t) d.dataset.theme = t;
        } catch {
          // Without storage the page follows the system theme.
        }
      })();
    </script>
  </head>

  <body>
    <a class="skip" href="#main">{zh ? '跳到正文' : 'Skip to content'}</a>

    <header class="site">
      <div class="wrap">
        <a class="brand-container" href={home} aria-label={zh ? 'Yaner Apps 首页' : 'Yaner Apps home'}>
          <span class="brand-name">Yaner Apps</span>
        </a>
        <nav class="site-nav" aria-label={zh ? '站点导航' : 'Site navigation'}>
          <a href={privacy} aria-current={currentPath.endsWith('/privacy') ? 'page' : undefined}>{zh ? '隐私' : 'Privacy'}</a>
          <a href={support} aria-current={currentPath.endsWith('/support') ? 'page' : undefined}>{zh ? '支持' : 'Support'}</a>
          {zh
            ? <a class="lang-switch" href={enPath} hreflang="en" lang="en" aria-label="English">EN</a>
            : <a class="lang-switch" href={zhPath} hreflang="zh-Hans" lang="zh-Hans" aria-label="中文">ZH</a>}
          <button class="theme-toggle" type="button" aria-label={zh ? '切换深浅色' : 'Toggle dark mode'}>
            <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
              <circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="1.5" />
              <path d="M8 1.5a6.5 6.5 0 0 1 0 13z" fill="currentColor" />
            </svg>
          </button>
        </nav>
      </div>
    </header>

    <main class="wrap" id="main">
      <slot />
    </main>

    <footer class="site">
      <div class="wrap">
        <span><span class="motto">{zh ? '逐风而行' : 'Ride the Wind'}</span> &middot; &copy; 2026 Yaner Apps</span>
        <div class="footer-links">
          <a href={home}>{zh ? '首页' : 'Home'}</a>
          <a href={privacy}>{zh ? '隐私政策' : 'Privacy Policy'}</a>
          <a href={support}>{zh ? '支持' : 'Support'}</a>
        </div>
        <p class="colophon">
          {zh
            ? '静态站点 · 无追踪 · 字体自托管 · 燕子由代码绘制'
            : 'Static site · No tracking · Self-hosted fonts · Swallow drawn in code'}
        </p>
      </div>
    </footer>

    <!-- Theme toggle: an explicit choice is stored; picking the system theme clears it. -->
    <script is:inline>
      document.addEventListener('click', function (ev) {
        if (!ev.target.closest('.theme-toggle')) return;
        const d = document.documentElement;
        const sys = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        const next = (d.dataset.theme || sys) === 'dark' ? 'light' : 'dark';
        try {
          if (next === sys) localStorage.removeItem('theme');
          else localStorage.setItem('theme', next);
        } catch {
          // Without storage the choice lasts until the next page.
        }
        if (next === sys) delete d.dataset.theme;
        else d.dataset.theme = next;
      });
    </script>

    <!-- Long documents get a table of contents built from their h2s; CSS shows it only where the margin is wide -->
    <script is:inline>
      (function () {
        function toc() {
          const prose = document.querySelector('.prose');
          const heads = prose ? prose.querySelectorAll('h2') : [];
          if (heads.length < 4) return;
          const nav = document.createElement('nav');
          nav.className = 'toc';
          nav.setAttribute('aria-label', document.documentElement.lang.indexOf('zh') === 0 ? '目录' : 'Contents');
          heads.forEach(function (h) {
            const text = h.textContent.replace(/^\d+\.\s*/, '').trim();
            if (!h.id) h.id = text.toLowerCase().replace(/[^\p{L}\p{N}]+/gu, '-').replace(/^-|-$/g, '');
            const a = document.createElement('a');
            a.href = '#' + h.id;
            a.textContent = text;
            nav.appendChild(a);
          });
          const rail = document.createElement('div');
          rail.className = 'toc-rail';
          rail.appendChild(nav);
          prose.prepend(rail);
        }
        toc();
      })();
    </script>

    <!-- Scroll reveal -->
    <script is:inline>
      (function () {
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        function reveal() {
          const items = document.querySelectorAll('.reveal:not(.is-visible)');
          if (reduced || !('IntersectionObserver' in window)) {
            items.forEach(function (el) {
              el.classList.add('is-visible');
            });
            return;
          }
          let seen = 0;
          const io = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (entry) {
                if (!entry.isIntersecting) return;
                const el = entry.target;
                el.style.transitionDelay = Math.min(seen++ % 4, 3) * 60 + 'ms';
                el.classList.add('is-visible');
                io.unobserve(el);
              });
            },
            { rootMargin: '999% 0px -6% 0px', threshold: 0.05 }
          );
          items.forEach(function (el) {
            io.observe(el);
          });
        }
        reveal();
      })();
    </script>
  </body>
</html>
