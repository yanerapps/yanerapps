---
import '@fontsource/ibm-plex-serif/400-italic.css';
import '../styles/studio.css';
import Shell from '../../lib/ui/Shell.astro';
import SiteHeader from '../../lib/ui/SiteHeader.astro';
import SiteFooter from '../../lib/ui/SiteFooter.astro';
import { cleanPath } from '../../lib/paths';
import { appIds, appPaths, mailto, studio } from '../../apps/registry';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Yaner Apps — We make quality apps.',
  description = 'Yaner Apps makes quality apps. Maker of GPS-Go, a no-root location simulator.',
} = Astro.props;

const currentPath = cleanPath(Astro.url.pathname);
// Support follows the app whose pages you are on; site-wide pages link the support overview.
const app = appIds.find((id) => currentPath.startsWith(`/${id}/`));
const year = new Date().getFullYear();
const links = [
  { href: '/#manifesto', label: 'Manifesto' },
  { href: '/#apps', label: 'Apps' },
  { href: '/#contact', label: 'Contact' },
];
const footerLinks = [
  { href: '/privacy', label: 'Privacy' },
  { href: app ? appPaths(app).support : '/support', label: 'Support' },
  { href: mailto(), label: studio.email },
];
---

<Shell title={title} description={description} image="/og.png" favicon="/favicon.svg">
  <SiteHeader home="/" name={studio.name} links={links} />
  <main id="main">
    <slot />
  </main>
  <SiteFooter links={footerLinks}>
    <Fragment slot="owner"
      ><img class="studio-mark" src="/favicon.svg" alt="" width="20" height="20" /><span class="motto">Ride the Wind</span>{` · © ${year} ${studio.name}`}</Fragment>
    <Fragment slot="fineprint">Static site · No tracking · Swallow drawn in code</Fragment>
  </SiteFooter>
</Shell>

<script>
  // Long documents get a table of contents built from their h2s; CSS shows it only where the margin is wide.
  const prose = document.querySelector('.prose');
  const heads = prose ? [...prose.querySelectorAll('h2')] : [];
  if (prose && heads.length >= 4) {
    const nav = document.createElement('nav');
    nav.className = 'toc';
    nav.setAttribute('aria-label', 'Contents');
    for (const h of heads) {
      const text = (h.textContent ?? '').replace(/^\d+\.\s*/, '').trim();
      if (!h.id)
        h.id = text
          .toLowerCase()
          .replace(/[^\p{L}\p{N}]+/gu, '-')
          .replace(/^-|-$/g, '');
      const a = document.createElement('a');
      a.href = `#${h.id}`;
      a.textContent = text;
      nav.append(a);
    }
    const rail = document.createElement('div');
    rail.className = 'toc-rail';
    rail.append(nav);
    prose.prepend(rail);
  }
</script>
