---
interface Props {
  inscription: string; // the studio motto, Ride the Wind
}
const { inscription } = Astro.props;
---

<div class="sky-frame">
  <div class="sky" aria-hidden="true"><canvas></canvas></div>
  <p class="sky-inscription motto">{inscription}</p>
</div>

<script>
  // three.js is only fetched once the sky is about to scroll into view.
  const el = document.querySelector<HTMLElement>('.sky');
  if (el) {
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        import('./swallow').then(
          (m) => m.mount(el),
          () => {}, // three.js failed to load: the still poster stays
        );
      },
      { rootMargin: '400px 0px' },
    );
    io.observe(el);
  }
</script>

<style>
  .sky-frame {
    position: relative;
  }

  /* The sky washes out into the page on every side instead of ending at a frame. */
  .sky {
    position: relative;
    aspect-ratio: 4 / 3;
    background: linear-gradient(var(--sky-top), var(--sky-mid) 55%, var(--sky-bottom));
    --fade: transparent, rgb(0 0 0 / 0.4) 6%, rgb(0 0 0 / 0.8) 12%, #000 20%, #000 80%,
      rgb(0 0 0 / 0.8) 88%, rgb(0 0 0 / 0.4) 94%, transparent;
    mask-image: linear-gradient(90deg, var(--fade)), linear-gradient(var(--fade));
    mask-composite: intersect;
  }

  /* A still of the bird's first frame (npm run sky-poster) holds its place until three.js draws, and
     stays when JavaScript, the download or WebGL fails. */
  .sky::before {
    content: '';
    position: absolute;
    inset: 0;
    background: url('/sky/swallow-wide-light.webp') center / cover no-repeat;
    transition: opacity 0.6s var(--ease);
  }

  :global([data-theme='dark']) .sky::before {
    background-image: url('/sky/swallow-wide-dark.webp');
  }

  .sky canvas {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.6s var(--ease);
  }

  .sky[data-live]::before {
    opacity: 0;
  }

  .sky[data-live] canvas {
    opacity: 1;
  }

  /* Once the hero stacks, a shorter sky keeps the apps closer to the top. */
  @media (max-width: 900px) {
    .sky {
      aspect-ratio: 16 / 10;
    }

    .sky::before {
      background-image: url('/sky/swallow-narrow-light.webp');
    }

    :global([data-theme='dark']) .sky::before {
      background-image: url('/sky/swallow-narrow-dark.webp');
    }
  }

  .sky-inscription {
    position: absolute;
    top: 7%;
    right: 6%;
    white-space: nowrap;
    line-height: 1;
    font-size: var(--step-1);
    color: var(--sky-ink);
    opacity: 0.85;
  }
</style>
