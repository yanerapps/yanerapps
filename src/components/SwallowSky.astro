---
interface Props {
  inscription: string; // the studio motto in the page's language: 逐风而行 / Ride the Wind
}
const { inscription } = Astro.props;
---

<div class="sky-frame">
  <div class="sky reveal" aria-hidden="true"><canvas></canvas></div>
  <p class="sky-inscription motto reveal">{inscription}</p>
</div>

<script>
  // three.js is only fetched once the sky is about to scroll into view.
  const el = document.querySelector<HTMLElement>('.sky');
  if (el) {
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        import('./swallow').then((m) => m.mount(el), () => el.parentElement?.remove());
      },
      { rootMargin: '400px 0px' },
    );
    io.observe(el);
  }
</script>
