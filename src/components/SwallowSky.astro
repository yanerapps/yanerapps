---
interface Props {
  inscription: string; // the studio motto in the page's language: 逐风而行 / Ride the Wind
}
const { inscription } = Astro.props;
---

<div class="sky-frame">
  <div class="sky reveal" aria-hidden="true"><canvas></canvas></div>
  <p class="sky-inscription motto reveal">{inscription}</p>
</div>

<script>
  // three.js is only fetched once the sky is about to scroll into view. Client-side navigation swaps
  // the page's DOM, so the scene is mounted per page and torn down before the swap.
  let dispose: (() => void) | undefined;
  let io: IntersectionObserver | undefined;
  function init() {
    const el = document.querySelector<HTMLElement>('.sky');
    if (!el || el.dataset.live !== undefined) return;
    el.dataset.live = '';
    io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io?.disconnect();
        import('./swallow').then(
          (m) => {
            if (el.isConnected) dispose = m.mount(el);
          },
          () => el.parentElement?.remove(),
        );
      },
      { rootMargin: '400px 0px' },
    );
    io.observe(el);
  }
  init();
  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', () => {
    io?.disconnect();
    dispose?.();
    dispose = undefined;
  });
</script>
