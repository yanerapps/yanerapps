---
import '@fontsource-variable/instrument-sans/wdth.css';
import '@fontsource-variable/newsreader';
import '@fontsource-variable/newsreader/wght-italic.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
  lang?: string;
}

const {
  title = 'Yaner Apps — We make quality apps.',
  description = 'Yaner Apps makes quality apps. Maker of GPS-Go, a no-root location simulator.',
  currentPath = '/',
  lang = 'en',
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site || 'https://yanerapps.com').href;

const zh = lang.startsWith('zh');
const home = zh ? '/zh/' : '/';
const privacy = zh ? '/privacy/zh/' : '/privacy/';
const support = zh ? '/support/zh/' : '/support/';

// Every page has a counterpart: /x/ <-> /x/zh/
const enPath = zh ? currentPath.replace(/zh\/$/, '') : currentPath;
const zhPath = enPath + 'zh/';
const site = Astro.site || 'https://yanerapps.com';
const enUrl = new URL(enPath, site).href;
const zhUrl = new URL(zhPath, site).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f4f1ea" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0e0d0b" />

    <!-- Open Graph / Social Meta -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content="https://yanerapps.com/og.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="zh-CN" href={zhUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />

    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        try {
          var t = localStorage.getItem('theme');
          if (t) d.dataset.theme = t;
        } catch (e) {}
      })();
    </script>
  </head>

  <body>
    <a class="skip" href="#main">{zh ? '跳到正文' : 'Skip to content'}</a>

    <header class="site">
      <div class="wrap">
        <a class="brand-container" href={home} aria-label={zh ? 'Yaner Apps 首页' : 'Yaner Apps home'}>
          <span class="brand-name">Yaner Apps</span>
        </a>
        <nav class="site-nav" aria-label={zh ? '站点导航' : 'Site navigation'}>
          <a href={privacy} aria-current={currentPath.startsWith('/privacy') ? 'page' : undefined}>{zh ? '隐私' : 'Privacy'}</a>
          <a href={support} aria-current={currentPath.startsWith('/support') ? 'page' : undefined}>{zh ? '支持' : 'Support'}</a>
          {zh
            ? <a class="lang-switch" href={enPath} hreflang="en" lang="en" aria-label="English">EN</a>
            : <a class="lang-switch" href={zhPath} hreflang="zh-CN" lang="zh-CN" aria-label="中文">ZH</a>}
          <button class="theme-toggle" type="button" aria-label={zh ? '切换深浅色' : 'Toggle dark mode'}>
            <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
              <circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="1.5" />
              <path d="M8 1.5a6.5 6.5 0 0 1 0 13z" fill="currentColor" />
            </svg>
          </button>
        </nav>
      </div>
    </header>

    <main class="wrap" id="main">
      <slot />
    </main>

    <footer class="site">
      <div class="wrap">
        <span>{zh ? '用心制作' : 'Made with love'} &middot; &copy; 2026 Yaner Apps</span>
        <div class="footer-links">
          <a href={home}>{zh ? '首页' : 'Home'}</a>
          <a href={privacy}>{zh ? '隐私政策' : 'Privacy Policy'}</a>
          <a href={support}>{zh ? '支持' : 'Support'}</a>
        </div>
      </div>
    </footer>

    <!-- Theme toggle: an explicit choice is stored; picking the system theme clears it -->
    <script is:inline>
      document.querySelector('.theme-toggle').addEventListener('click', function () {
        var d = document.documentElement;
        var sys = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        var next = (d.dataset.theme || sys) === 'dark' ? 'light' : 'dark';
        try {
          if (next === sys) localStorage.removeItem('theme');
          else localStorage.setItem('theme', next);
        } catch (e) {}
        if (next === sys) delete d.dataset.theme;
        else d.dataset.theme = next;
      });
    </script>

    <!-- Scroll Reveal Enhancement -->
    <script is:inline>
      (function () {
        var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var items = document.querySelectorAll('.reveal');
        if (reduced || !('IntersectionObserver' in window)) {
          items.forEach(function (el) {
            el.classList.add('is-visible');
          });
          return;
        }
        var seen = 0;
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (!entry.isIntersecting) return;
              var el = entry.target;
              el.style.transitionDelay = Math.min(seen++ % 4, 3) * 60 + 'ms';
              el.classList.add('is-visible');
              io.unobserve(el);
            });
          },
          { rootMargin: '999% 0px -6% 0px', threshold: 0.05 }
        );
        items.forEach(function (el) {
          io.observe(el);
        });
      })();
    </script>
  </body>
</html>
