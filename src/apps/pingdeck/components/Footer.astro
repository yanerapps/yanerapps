---
import SiteFooter from '../../../lib/ui/SiteFooter.astro';
import { mailto } from '../../registry';
import { site } from '../data/site';

const links = [
  { href: site.supportUrl, label: 'Support' },
  { href: site.privacyUrl, label: 'Privacy policy' },
  { href: site.termsUrl, label: 'Terms' },
  { href: mailto('PingDeck'), label: site.email },
];
---

<SiteFooter links={links}>
  <Fragment slot="studio">
    <img src="/favicon.svg" alt="" width="20" height="20" />
    <span>Designed by <a href="/">Yaner Apps</a>.</span>
    <a href="/#apps">More apps →</a>
  </Fragment>
  <Fragment slot="fineprint">
    Monitor only hosts and networks you own or have permission to test.
  </Fragment>
</SiteFooter>
