---
import { mailto } from '../../registry';
import { base, site } from '../data/site';
---

<section class="closing" id="get" aria-labelledby="get-title">
  <div class="page">
    <div class:list={['band', 'panel', 'reveal', { 'has-store': site.playStoreUrl }]}>
      <img class="closing-icon" src={`${base}/icon.png`} alt="" width="52" height="52" />
      <div class="text">
        <h2 id="get-title">
          {site.playStoreUrl ? 'PingDeck is on Google Play.' : 'PingDeck is coming soon to Google Play.'}
        </h2>
        <p>
          Android {site.minAndroid} or later. Questions? See <a href={site.supportUrl}>support</a>, or
          {' '}<a href={mailto('PingDeck')}>email us</a>.
        </p>
      </div>
      {
        site.playStoreUrl && (
          <a class="btn btn-primary" href={site.playStoreUrl} rel="noopener">Get it on Google Play</a>
        )
      }
    </div>
  </div>
</section>

<style>
  .closing {
    padding-block: calc(var(--section-space) / 2) var(--section-space);
  }

  .band {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 20px 24px;
    padding: clamp(20px, 4vw, 32px);
  }

  .has-store {
    grid-template-columns: auto minmax(0, 1fr) auto;
  }

  .closing-icon {
    border-radius: 12px;
  }

  h2 {
    font-size: clamp(1.25rem, 2.6vw, 1.625rem);
    letter-spacing: -0.02em;
  }

  .text p {
    margin-top: 4px;
    color: var(--muted);
    font-size: var(--step--1);
  }

  @media (max-width: 640px) {
    .band {
      grid-template-columns: auto minmax(0, 1fr);
      align-items: start;
    }

    .band > .btn {
      grid-column: 1 / -1;
      justify-self: start;
    }
  }
</style>
