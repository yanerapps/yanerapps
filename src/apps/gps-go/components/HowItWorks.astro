---
import AppIcon from './AppIcon.astro';
import ProviderFlow from './ProviderFlow.svelte';

const sourceDetail = 'Sends your simulated location';
const targetDetail = 'A simulated location for your apps';
const sinks = [
  { name: 'GPS provider', detail: 'For apps using GPS location', short: 'Apps using GPS' },
  { name: 'Network provider', detail: 'For apps using network location', short: 'Apps using network' },
  { name: 'Fused location', detail: 'For apps using Google Play services', short: 'Google Play services' },
];
---

<section class="section how" id="how" aria-labelledby="how-title">
  <div class="page">
    <header class="section-head">
      <p class="kicker reveal">03 · How it works</p>
      <h2 class="reveal" id="how-title">One position, sent everywhere apps look.</h2>
      <p class="lede reveal">
        Android apps read location from more than one place. GPS-Go sends the same fix to all of them, so every app on
        the phone agrees on where it is.
      </p>
    </header>

    <div class="flow-wrapper reveal" data-flow-wrapper>
      <div class="flow" data-provider-flow>
        <div class="flow-source" data-flow-source>
          <AppIcon size={44} />
          <p><strong>GPS-Go</strong><span>{sourceDetail}</span></p>
        </div>
        <ol class="flow-sinks" data-flow-sinks>
          {
            sinks.map((sink) => (
              <li class="flow-node" data-flow-provider>
                <strong>{sink.name}</strong>
                <span class="detail">{sink.detail}</span>
                <span class="detail-short">{sink.short}</span>
              </li>
            ))
          }
        </ol>
        <p class="flow-target" data-flow-target><strong>Your apps</strong><span>{targetDetail}</span></p>
      </div>
      <div class="flow-canvas"><ProviderFlow {sinks} {sourceDetail} {targetDetail} client:visible /></div>
    </div>
  </div>
</section>

<style>
  .flow {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(3rem, 5vw, 4.5rem);
  }

  .flow-wrapper {
    position: relative;
  }

  .flow-canvas {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
  }

  [data-flow-ready] .flow {
    opacity: 0;
  }

  [data-flow-ready] .flow-canvas {
    opacity: 1;
  }



  .flow p,
  .flow-node {
    display: grid;
    gap: 0.2rem;
  }

  .flow strong {
    font-weight: 620;
  }

  .flow span {
    font-size: var(--step--1);
    color: var(--muted);
  }

  .flow-source,
  .flow-target,
  .flow-sinks {
    position: relative;
  }

  .flow-source,
  .flow-target {
    padding: 1.5625rem;
    border-radius: var(--radius-sheet);
    background: var(--panel);
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
  }

  .flow-source {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .flow-source :global(.app-icon) {
    flex: none;
  }

  .flow-sinks {
    display: grid;
    grid-auto-rows: 1fr;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .flow-node {
    align-content: center;
    padding: 1.125rem 1rem;
    border-radius: 1.25rem;
    background: var(--panel);
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
  }

  .detail-short {
    display: none;
  }

  @media (max-width: 860px) {
    .flow {
      grid-template-columns: 1fr;
      justify-items: center;
      gap: 4rem;
    }

    .flow-source,
    .flow-target {
      width: min(100%, 20rem);
    }

    .flow-target {
      text-align: center;
    }

    .flow-sinks {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.5rem;
      width: 100%;
    }

    .flow-node {
      min-height: 5.5rem;
      padding: 1rem 0.5rem;
      text-align: center;
    }

    .flow-node .detail {
      display: none;
    }

    .flow-node .detail-short {
      display: block;
    }
  }

  @media (max-width: 500px) {
    .flow-node strong {
      font-size: 0.8125rem;
    }
  }
</style>
