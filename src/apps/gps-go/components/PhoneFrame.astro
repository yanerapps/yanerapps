---
import type { ImageMetadata } from 'astro';
import Screenshot from './Screenshot.astro';

interface Props {
  /** Leave out to fill the screen through the slot instead. */
  image?: ImageMetadata;
  dark?: ImageMetadata;
  alt?: string;
  /** Rendered width hint for responsive images, e.g. "(min-width: 1024px) 340px, 70vw". */
  sizes?: string;
  eager?: boolean;
  class?: string;
}

const { image, dark, alt = '', sizes, eager = false, class: className } = Astro.props;
---

<div class:list={['phone', className]}>
  <div class="phone-body">
    <div class="phone-screen">
      {image && sizes && <Screenshot src={image} dark={dark} alt={alt} sizes={sizes} eager={eager} />}
      <slot />
      <span class="phone-camera" aria-hidden="true"></span>
    </div>
  </div>
</div>

<style>
  .phone {
    container-type: inline-size;
    width: 100%;
  }

  .phone-body {
    position: relative;
    padding: 2.6cqi;
    border-radius: 9cqi;
    background: linear-gradient(150deg, #30365f 0%, #151936 38%, #0b0e24 100%);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.09),
      inset 0 0 0 0.9cqi #0a0c1e,
      0 3cqi 8cqi -2cqi var(--phone-shadow),
      0 14cqi 30cqi -12cqi var(--phone-shadow);
  }

  .phone-body::before,
  .phone-body::after {
    content: '';
    position: absolute;
    right: -0.8cqi;
    width: 0.8cqi;
    border-radius: 0 0.8cqi 0.8cqi 0;
    background: linear-gradient(90deg, #1a1e3c, #2c3160);
  }

  .phone-body::before {
    top: 21%;
    height: 7%;
  }

  .phone-body::after {
    top: 31%;
    height: 13%;
  }

  .phone-screen {
    position: relative;
    aspect-ratio: 1080 / 2424;
    border-radius: 6.5cqi;
    overflow: hidden;
    background: #05060e;
    isolation: isolate;
  }

  .phone-screen :global(picture),
  .phone-screen :global(img) {
    width: 100%;
    height: 100%;
  }

  .phone-screen :global(img) {
    object-fit: cover;
  }

  .phone-camera {
    position: absolute;
    top: 2.3cqi;
    left: 50%;
    width: 3.5cqi;
    aspect-ratio: 1;
    translate: -50% 0;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #1b2040 0 18%, #04050c 45%);
    z-index: 3;
  }
</style>
