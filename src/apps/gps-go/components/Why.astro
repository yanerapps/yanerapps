---
const tools = ['Emulator', 'adb', 'GPS-Go'];

const rows = [
  { what: 'Runs on a real phone', values: ['No', 'Yes', 'Yes'] },
  { what: 'Works with no computer attached', values: ['No', 'No', 'Yes'] },
  { what: 'Moves along routes and GPX tracks', values: ['Yes', 'Scripted', 'Yes'] },
  { what: 'Steer by hand over the app you’re testing', values: ['No', 'No', 'Yes'] },
  { what: 'Usable without Android Studio or a terminal', values: ['No', 'No', 'Yes'] },
];

const cases = [
  {
    who: 'Location features',
    what: 'Check a geofence alert, a feature that only exists in one city, or how an app holds up over hours on a looping route, without going there.',
  },
  {
    who: 'Fitness and navigation apps',
    what: 'Play a recorded GPX run back along its exact path, lap after lap, until the bug it caught shows up again.',
  },
  {
    who: 'Demos and screenshots',
    what: 'Record at a sample location so your own street stays out of the shot.',
  },
];
---

<section class="section" id="why" aria-labelledby="why-title">
  <div class="page">
    <header class="section-head">
      <p class="kicker reveal">01 · Why</p>
      <h2 class="reveal" id="why-title">Test location features on a real phone.</h2>
      <p class="lede reveal">
        The Android emulator and adb can already set a location. GPS-Go does it on the phone itself, with nothing plugged
        in. The location holds still or moves along a route while you use the app you’re testing, and anyone on the team
        can run it.
      </p>
    </header>

    <div class="compare panel reveal">
      <table aria-label="GPS-Go compared with the Android emulator and adb">
        <thead>
          <tr>
            <td></td>
            {tools.map((t) => <th scope="col">{t}</th>)}
          </tr>
        </thead>
        <tbody>
          {
            rows.map((r) => (
              <tr>
                <th scope="row">{r.what}</th>
                {r.values.map((v) => (
                  <td class:list={{ yes: v === 'Yes', no: v === 'No' }}>{v}</td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <ul class="cases">
      {
        cases.map((c) => (
          <li class="reveal">
            <h3>{c.who}</h3>
            <p>{c.what}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .compare {
    padding: clamp(8px, 2vw, 16px) clamp(16px, 3vw, 24px);
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--step--1);
  }

  th,
  td {
    padding: 14px 8px;
    border-top: 1px solid var(--line);
    text-align: center;
  }

  thead th,
  thead td {
    border-top: 0;
    font: 12.5px/20px var(--mono);
    letter-spacing: 0.5px;
    color: var(--dim);
  }

  thead th:last-child {
    color: var(--accent);
  }

  tbody th {
    padding-left: 0;
    text-align: left;
    font-weight: 600;
  }

  td {
    width: 18%;
    color: var(--muted);
  }

  td.no {
    color: var(--dim);
  }

  td:last-child {
    color: var(--text);
    font-weight: 600;
  }

  td.yes:last-child::before {
    content: '';
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 8px;
    border-radius: 50%;
    background: var(--accent);
    vertical-align: 0.1em;
  }

  .cases {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    margin: clamp(28px, 5vw, 40px) 0 0;
    padding: 0;
    list-style: none;
  }

  .cases h3 {
    font-size: 16px;
  }

  .cases p {
    margin-top: 6px;
    color: var(--muted);
    font-size: var(--step--1);
  }

  @media (max-width: 760px) {
    .compare {
      padding-inline: 12px;
    }

    th,
    td {
      padding: 12px 4px;
    }

    thead th,
    td {
      width: 1%;
      white-space: nowrap;
    }

    td.yes:last-child::before {
      display: none;
    }

    .cases {
      grid-template-columns: minmax(0, 1fr);
      gap: 18px;
    }
  }
</style>
