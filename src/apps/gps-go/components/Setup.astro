---
import Screenshot from './Screenshot.astro';
import SetupFlow from './SetupFlow.svelte';
import aboutLight from '../assets/screens/setup-about-light.webp';
import aboutDark from '../assets/screens/setup-about-dark.webp';
import developerLight from '../assets/screens/setup-developer-light.webp';
import developerDark from '../assets/screens/setup-developer-dark.webp';
---

<section class="section" id="setup" aria-labelledby="setup-title">
  <div class="page">
    <header class="section-head">
      <p class="kicker">01 · Setup</p>
      <h2 class="heading" id="setup-title">Set up once. The app walks you through it.</h2>
      <p class="lede">
        Android lets an app simulate location only after you allow it in Developer options. GPS-Go checks each requirement
        and opens the right settings page for you. Menu names vary a little between phone makers.
      </p>
    </header>

    <nav class="setup-overview" aria-label="Setup steps" data-setup-flow>
      <div class="setup-canvas"><SetupFlow client:visible /></div>
      <ol class="overview-steps">
        <li><a href="#setup-developer" data-setup-node><span>1</span>Developer options</a></li>
        <li><a href="#setup-mock-app" data-setup-node><span>2</span>Choose GPS-Go</a></li>
        <li><a href="#setup-permissions" data-setup-node><span>3</span>Allow permissions</a></li>
        <li><a href="#points" data-setup-node><span>4</span>Start mocking</a></li>
      </ol>
    </nav>

    <ol class="steps">
      <li class="step" id="setup-developer">
        <div class="step-copy">
          <span class="step-number readout" aria-hidden="true">1</span>
          <h3>Turn on Developer options</h3>
          <p>In Settings, open About phone and tap Build number seven times. Some phones keep it under Software information.</p>
        </div>
        <div class="step-shots">
          <Screenshot
            src={aboutLight}
            dark={aboutDark}
            alt="About phone in Android Settings: Android version 17, and below it the Build number row."
            sizes="(min-width: 960px) 26rem, 90vw"
            class="card-shot"
          />
        </div>
      </li>
      <li class="step" id="setup-mock-app">
        <div class="step-copy">
          <span class="step-number readout" aria-hidden="true">2</span>
          <h3>Choose GPS-Go as the mock location app</h3>
          <p>
            In Developer options, open Select mock location app and pick GPS-Go. The app’s setup step explains why and opens
            Developer options for you.
          </p>
        </div>
        <div class="step-shots">
          <Screenshot
            src={developerLight}
            dark={developerDark}
            alt="Developer options, Location section: Select mock location app, set to GPS-Go."
            sizes="(min-width: 960px) 26rem, 90vw"
            class="card-shot"
          />
        </div>
      </li>
      <li class="step step-text-only" id="setup-permissions">
        <div class="step-copy">
          <span class="step-number readout" aria-hidden="true">3</span>
          <h3>Allow location and the overlay</h3>
          <p>
            Location is needed to run the mock, and display over other apps powers the floating joystick. Notifications and
            unrestricted battery use are recommended.
          </p>
        </div>
      </li>
    </ol>
  </div>
</section>

<style>
  .section-head {
    gap: 0.75rem;
    margin-bottom: clamp(1.5rem, 3vw, 2rem);
  }

  .setup-overview {
    position: relative;
    margin: 0 0 clamp(3rem, 5vw, 4rem);
  }

  .setup-canvas {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .overview-steps {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .overview-steps a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 5rem;
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sheet);
    background: var(--panel);
    color: var(--text);
    font-weight: 620;
    text-decoration: none;
  }

  .overview-steps a:hover {
    border-color: var(--accent);
  }

  .overview-steps span {
    display: grid;
    place-items: center;
    flex: none;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background: var(--accent);
    color: var(--bg);
    font-size: 0.8125rem;
  }


  .steps {
    display: grid;
    gap: clamp(3rem, 7vw, 5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .step {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }

  .step-text-only {
    grid-template-columns: minmax(0, 1fr);
  }

  .step-copy {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    gap: 0.4rem 1rem;
    align-items: start;
  }

  .step-number {
    grid-row: span 2;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    border: 1px solid var(--accent);
    color: var(--accent);
    font-size: 1.125rem;
  }

  .step-copy h3 {
    font-size: var(--step-1);
    line-height: 1.25;
    margin-top: 0.4rem;
  }

  .step-copy p {
    color: var(--muted);
    max-width: 30rem;
  }

  .step-shots {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    align-items: center;
    justify-content: center;
  }

  .step-shots :global(picture) {
    flex: 1 1 15rem;
    max-width: 26rem;
  }

  .step-shots :global(.card-shot) {
    width: 100%;
    border-radius: var(--radius-sheet);
    box-shadow:
      0 0 0 1px var(--line-2),
      0 30px 60px -30px var(--phone-shadow);
  }

  @media (max-width: 860px) {
    .overview-steps {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .overview-steps a {
      min-height: 3.25rem;
      padding-block: 0.65rem;
    }

    .step {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
