---
import Screenshot from './Screenshot.astro';
import Hotspots from './Hotspots.astro';
import { overlayImage, parts } from '../data/anatomy';

const initial = parts.findIndex((p) => p.id === 'stick');
// The overlay window's corner radius in the 1080-px-wide captures.
const PANEL_RADIUS_PX = 63;
const panelRadius = (w: number, h: number) =>
  `--panel-radius: ${((PANEL_RADIUS_PX / w) * 100).toFixed(2)}% / ${((PANEL_RADIUS_PX / h) * 100).toFixed(2)}%`;
---

<section class="section" id="joystick" aria-labelledby="joystick-title">
  <div class="page">
    <header class="section-head">
      <p class="kicker">03 · The joystick</p>
      <h2 id="joystick-title">The joystick, piece by piece.</h2>
      <p class="lede">
        It floats over the app you are testing, so you can move, jump and pause without switching apps. Pick a part to
        see what it does.
      </p>
    </header>

    <div class="anatomy" data-anatomy data-initial={initial}>
      <div class="anatomy-figure" style={panelRadius(overlayImage.image.width, overlayImage.image.height)}>
        <Screenshot src={overlayImage.image} dark={overlayImage.dark} alt={overlayImage.alt} sizes="(min-width: 860px) 26rem, 70vw" />
        <Hotspots rects={parts.map((p) => p.rect)} labels={parts.map((p) => p.title)} controls={parts.map((p) => `part-${p.id}`)} {initial} />
      </div>

      <div class="details">
        {
          parts.map((p, i) => (
            <article class="detail" id={`part-${p.id}`} data-detail={i} data-open={i === initial ? '' : undefined}>
              <h3>{p.title}</h3>
              <p>{p.body}</p>
              {p.fragment && (
                <figure
                  class:list={['fragment', `fragment-${p.id}`, { 'fragment-panel': p.fragment.panel }]}
                  style={p.fragment.panel ? panelRadius(p.fragment.image.width, p.fragment.image.height) : undefined}
                >
                  <Screenshot src={p.fragment.image} dark={p.fragment.dark} alt={p.fragment.alt} sizes="20rem" />
                  <figcaption>{p.fragment.caption}</figcaption>
                </figure>
              )}
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  import { initAnatomy } from '../scripts/anatomy';
  initAnatomy();
</script>

<style>
  .anatomy {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: clamp(2.5rem, 7vw, 7rem);
  }

  .anatomy-figure {
    position: relative;
    container-type: inline-size;
    width: clamp(18rem, 32vw, 26rem);
    border-radius: var(--panel-radius);
    overflow: hidden;
    box-shadow:
      0 0 0 1px var(--line-2),
      0 30px 60px -30px var(--phone-shadow);
  }

  .anatomy-figure :global(.spot-light) {
    box-shadow: none;
  }

  .anatomy-figure :global(button.spot-marker) {
    translate: none;
    aspect-ratio: auto;
    border-radius: 3cqi;
    background: transparent;
    box-shadow: none;
    scale: 1;
  }

  .anatomy-figure :global(img) {
    width: 100%;
  }

  :global(html:not(.js)) .anatomy-figure :global(button.spot-marker) {
    display: none;
  }

  .detail {
    display: grid;
    gap: 0.9rem;
    max-width: 32rem;
  }

  .detail p {
    color: var(--muted);
  }

  :global(.js) .detail:not([data-open]) {
    display: none;
  }

  /* The detail drops in from the list above it. */
  :global(.js) .detail[data-open] {
    animation: detail-in 0.4s var(--ease);
  }

  @keyframes detail-in {
    from {
      opacity: 0;
      translate: 0 -8px;
    }
  }

  :global(html:not(.js)) .detail + .detail {
    margin-top: 2.5rem;
  }

  .fragment {
    margin: 0.75rem 0 0;
    display: grid;
    gap: 0.6rem;
    justify-items: start;
  }

  .fragment :global(img) {
    width: min(20rem, 100%);
    border-radius: 1rem;
    box-shadow: 0 0 0 1px var(--line-2);
  }

  .fragment-panel :global(img) {
    width: min(16rem, 100%);
    border-radius: var(--panel-radius);
  }

  .fragment-collapse :global(img),
  .fragment-readout :global(img) {
    width: min(14rem, 100%);
  }

  .fragment figcaption {
    font-size: var(--step--1);
    color: var(--muted);
  }

  @media (max-width: 860px) {
    .anatomy {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
    }

    .anatomy-figure {
      width: min(100%, 26rem);
    }
  }
</style>
