---
import AppIcon from './AppIcon.astro';
import SiteHeader from '../../../lib/ui/SiteHeader.astro';
import { base, site } from '../data/site';

const links = [
  { href: `${base}#why`, label: 'Why' },
  { href: `${base}#features`, label: 'Features' },
  { href: `${base}#how`, label: 'How it works' },
  { href: `${base}/guide`, label: 'Guide' },
  { href: `${base}/faq`, label: 'FAQ' },
];
---

<SiteHeader home={base} name={site.name} links={links}>
  <AppIcon slot="mark" size={24} />
</SiteHeader>
