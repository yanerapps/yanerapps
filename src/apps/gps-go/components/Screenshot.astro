---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  /** The same screen in the dark theme; shown in place of `src` when the site is dark. */
  dark?: ImageMetadata | undefined;
  alt: string;
  /** Rendered width hint, e.g. "(min-width: 960px) 20rem, 80vw". */
  sizes: string;
  eager?: boolean;
  class?: string;
}

const { src, dark, alt, sizes, eager = false, class: className } = Astro.props;
const shots = dark ? [{ image: src, theme: 'shot-light' }, { image: dark, theme: 'shot-dark' }] : [{ image: src, theme: '' }];
const widths = [...new Set([360, 540, 720, 1080].map((w) => Math.min(w, src.width)))];
---

{
  shots.map(({ image, theme }) => (
    <Picture
      src={image}
      alt={alt}
      sizes={sizes}
      widths={widths}
      formats={['avif']}
      fallbackFormat="webp"
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
      decoding="async"
      pictureAttributes={{ class: theme }}
      class={className ? `screenshot ${className}` : 'screenshot'}
    />
  ))
}
