---
import Screenshot from './Screenshot.astro';
import realismLight from '../assets/screens/realism-light.webp';
import realismDark from '../assets/screens/realism-dark.webp';
import movementLight from '../assets/screens/movement-light.webp';
import movementDark from '../assets/screens/movement-dark.webp';

const specs = [
  { term: 'Speed variation', detail: 'Lets the speed drift around your target, by up to ±50%.' },
  { term: 'GPS jitter', detail: 'Adds random drift within a radius you choose, standing still or on the move.' },
  { term: 'Accuracy and altitude', detail: 'Sets the horizontal accuracy and the elevation apps receive.' },
  { term: 'Speeds and stride', detail: 'Your own Walk, Run and Bike presets, and the stride used to count steps.' },
];
---

<section class="section" id="realism" aria-labelledby="realism-title">
  <div class="page realism">
    <div class="realism-copy">
      <p class="kicker">06 · Realism</p>
      <h2 class="heading" id="realism-title">Test with data that wobbles like the real thing.</h2>
      <p class="lede">
        Real GPS drifts, and real people don’t hold a perfect speed. Realism settings add both, so your app gets the kind
        of location data it will see in the field.
      </p>
      <dl class="specs">
        {
          specs.map((s) => (
            <div>
              <dt>{s.term}</dt>
              <dd>{s.detail}</dd>
            </div>
          ))
        }
      </dl>
    </div>
    <div class="realism-shots">
      <Screenshot
        src={realismLight}
        dark={realismDark}
        alt="Realism settings: speed variation on at ±15% with presets from ±5% to ±40%, and GPS jitter on with a 1.5 m radius and presets from 0.5 to 5 m."
        sizes="(min-width: 960px) 17rem, 44vw"
        class="shot shot-realism"
      />
      <Screenshot
        src={movementLight}
        dark={movementDark}
        alt="Movement settings: walk speed 4.3 km/h, run speed 10.1 km/h and bike speed 19.8 km/h, each with a slider."
        sizes="(min-width: 960px) 17rem, 44vw"
        class="shot shot-movement"
      />
    </div>
  </div>
</section>

<style>
  .realism {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(3rem, 8vw, 7rem);
    align-items: center;
  }

  .realism-copy {
    display: grid;
    gap: 1.25rem;
  }

  .specs {
    display: grid;
    gap: 1.25rem;
    margin: 1.5rem 0 0;
  }

  .specs div {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: 1rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .specs dt {
    font-weight: 620;
  }

  .specs dd {
    margin: 0;
    color: var(--muted);
  }

  .realism-shots {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 17rem));
    gap: 1.25rem;
    justify-content: center;
    align-items: start;
  }

  .realism-shots :global(.shot) {
    width: 100%;
    border-radius: var(--radius-sheet);
    box-shadow:
      0 0 0 1px var(--line-2),
      0 30px 60px -30px var(--phone-shadow);
  }

  .realism-shots :global(.shot-movement) {
    margin-top: clamp(3rem, 8vw, 6rem);
  }

  @media (max-width: 960px) {
    .realism {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .specs div {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }
</style>
