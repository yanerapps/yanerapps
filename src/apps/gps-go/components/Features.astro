---
import Screenshot from './Screenshot.astro';
import pickLight from '../assets/screens/pick-light.webp';
import pickDark from '../assets/screens/pick-dark.webp';
import routeLight from '../assets/screens/route-sheet-light.webp';
import routeDark from '../assets/screens/route-sheet-dark.webp';
import joystickLight from '../assets/screens/joystick-light.webp';
import joystickDark from '../assets/screens/joystick-dark.webp';
import placesLight from '../assets/screens/list-places-light.webp';
import placesDark from '../assets/screens/list-places-dark.webp';
import { base } from '../data/site';

const cards = [
  {
    art: 'pick',
    image: pickLight,
    dark: pickDark,
    link: 'View the pick guide',
    title: 'Pick any spot',
    body: 'Tap the map, search for a place, type coordinates or paste a map link. Then teleport there, or travel there at a set speed.',
    formats: ['48.8584, 2.2945', '48°51′30″N 2°17′40″E', 'geo: links', 'map links', 'place search'],
    guide: 'tour-pick',
    wide: true,
  },
  {
    art: 'route',
    image: routeLight,
    dark: routeDark,
    link: 'View the route guide',
    title: 'Routes, played back exactly',
    body: 'Draw a loop, import a GPX track or take a place shared from another map app. Pick Walk, Run, Bike or your own speed, then steer off with the joystick and rejoin where you left.',
    guide: 'tour-run',
  },
  {
    art: 'joystick',
    image: joystickLight,
    dark: joystickDark,
    link: 'View the joystick guide',
    title: 'A joystick over any app',
    body: 'A floating stick or D-pad stays on top of the app you’re using. After a jump it shows the distance and an estimated travel time at a reference speed you choose.',
    guide: 'joystick',
  },
  {
    art: 'library',
    image: placesLight,
    dark: placesDark,
    link: 'View the library guide',
    title: 'Places, routes and history',
    body: 'Every visit and route run lands in History. Keep the ones you reuse as Places and Routes, tag them, and reach them from the app, the joystick or a home-screen widget.',
    guide: 'library',
    wide: true,
  },
];

const more = [
  'GPS jitter and speed variation',
  'Light, dark or system theme',
  'Metric or imperial units',
  'Backup to a single file',
  'History that expires on a schedule',
  'Overlay size and opacity',
  'Satellite map',
  'Keeps running after you swipe the app away',
  'Resumes after a reboot',
  'Seven languages',
];
---

<section class="section" id="features" aria-labelledby="features-title">
  <div class="page">
    <header class="section-head center">
      <p class="kicker reveal">02 · Features</p>
      <h2 class="reveal" id="features-title">Every way to move, in one app.</h2>
      <p class="lede reveal">
        Jump to a point, play back a route or steer by hand, and keep what you reuse. Everything else stays out of your
        way.
      </p>
    </header>

    <div class="grid">
      {
        cards.map((c) => (
          <article class:list={['card', 'reveal', { wide: c.wide }]}>
            <div class="art" aria-hidden="true">
              <div class:list={['capture', c.art]}>
                <Screenshot src={c.image} dark={c.dark} alt="" sizes="(min-width: 900px) 448px, 90vw" />
              </div>
            </div>
            <h3>{c.title}</h3>
            <p>{c.body}</p>
            {c.formats && (
              <ul class="formats" aria-label="Accepted input">
                {c.formats.map((f) => (
                  <li>{f}</li>
                ))}
              </ul>
            )}
            <a class="more-link" href={`${base}/guide#${c.guide}`}>
              {c.link}
            </a>
          </article>
        ))
      }
      <article class="card rest reveal">
        <h3>And the rest</h3>
        <ul>
          {more.map((m) => <li>{m}</li>)}
        </ul>
      </article>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .card {
    display: flex;
    flex-direction: column;
    padding: 22px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: linear-gradient(var(--panel), color-mix(in srgb, var(--panel) 70%, var(--bg)));
  }

  .wide {
    grid-column: span 2;
  }

  .card h3 {
    margin: 22px 0 8px;
    font-size: 19px;
  }

  .card > p {
    color: var(--muted);
    font-size: 14.5px;
  }

  .more-link {
    margin-top: auto;
    padding-top: 14px;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
  }

  .art {
    position: relative;
    display: grid;
    place-items: center;
    height: 18rem;
    padding: 8px;
    overflow: hidden;
    border-radius: 12px;
    background:
      radial-gradient(90% 80% at 50% 0%, color-mix(in srgb, var(--accent) 8%, transparent), transparent),
      var(--panel-2);
  }

  .capture {
    position: relative;
    width: min(100%, 28rem);
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--line-2);
    border-radius: 10px;
    box-shadow: var(--shadow);
  }

  .capture :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pick :global(img) { object-position: center 65%; }
  .route :global(img) { object-position: center 65%; }
  .joystick :global(img) { object-position: center 33%; }
  .library :global(img) { object-position: center 27%; }

  .formats {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
  }

  .formats li {
    padding: 3px 9px;
    border: 1px solid var(--line-2);
    border-radius: 7px;
    background: var(--panel);
    font: 12px var(--mono);
  }

  .rest {
    grid-column: 1 / -1;
  }

  .rest h3 {
    margin-top: 0;
  }

  .rest ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 6px 0 0;
    padding: 0;
    list-style: none;
  }

  .rest li {
    padding: 6px 12px;
    border: 1px solid var(--line-2);
    border-radius: var(--radius-pill);
    color: var(--muted);
    font-size: 13px;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .wide {
      grid-column: auto;
    }
  }

</style>
