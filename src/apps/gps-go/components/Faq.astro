---
import { faqs } from '../data/faq';
---

<section class="section page-start" id="faq" aria-labelledby="faq-title">
  <div class="page faq">
    <header>
      <p class="kicker">FAQ</p>
      <h1 class="heading" id="faq-title">Questions, answered.</h1>
    </header>
    <div class="items">
      {
        faqs.map((f) => (
          <details>
            <summary>
              <span>{f.q}</span>
              <span class="toggle" aria-hidden="true" />
            </summary>
            <p>{f.a} {f.q === 'Does GPS-Go need root?' && <a href="/gps-go/guide#setup">See the setup guide.</a>}</p>
          </details>
        ))
      }
      <p class="help">Still have questions? <a href="/gps-go/support">Visit GPS-Go support.</a></p>
    </div>
  </div>
</section>

<style>
  .help { margin-top: 1rem; color: var(--muted); }

  .faq {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }

  h1 {
    font-size: clamp(2.5rem, 5.4vw, 4rem);
    overflow-wrap: anywhere;
  }

  .items {
    display: grid;
    gap: 0.5rem;
  }

  details {
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--panel);
    padding-inline: 1.25rem;
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 3.5rem;
    padding: 1.1rem 0;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.3;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover {
    color: var(--accent);
  }

  .toggle {
    position: relative;
    flex: none;
    width: 1.1rem;
    height: 1.1rem;
  }

  .toggle::before,
  .toggle::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto;
    height: 2px;
    margin-top: -1px;
    border-radius: 2px;
    background: currentColor;
    transition: transform 0.25s cubic-bezier(0.2, 0, 0, 1);
  }

  .toggle::after {
    transform: rotate(90deg);
  }

  details[open] .toggle::after {
    transform: rotate(0deg);
  }

  details p {
    padding: 0 3rem 1.5rem 0;
    color: var(--muted);
    max-width: 44rem;
  }

  @media (max-width: 860px) {
    .faq {
      grid-template-columns: 1fr;
    }

    details p {
      padding-right: 0;
    }
  }
</style>
