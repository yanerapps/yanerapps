---
import SiteFooter from '../../../lib/ui/SiteFooter.astro';
import { base, site } from '../data/site';

const mailto = `mailto:${site.email}?subject=${encodeURIComponent('GPS-Go')}`;
const links = [
  { href: `${base}/guide`, label: 'Guide' },
  { href: `${base}/faq`, label: 'FAQ' },
  { href: site.supportUrl, label: 'Support' },
  { href: site.privacyUrl, label: 'Privacy policy' },
  { href: mailto, label: site.email },
];
---

<SiteFooter links={links}>
  <Fragment slot="fineprint">
    GPS-Go is a development and testing tool. You are responsible for complying with the terms of any third-party apps
    you use it with.
  </Fragment>
</SiteFooter>
