---
interface Props {
  size?: number;
  class?: string;
}
const { size = 32, class: className } = Astro.props;
const clipId = `pin-${Math.random().toString(36).slice(2, 8)}`;
const pin = 'M37.44,67.75A24,24 0 1 1 70.56,67.75L57.45,80.24A5,5 0 0 1 50.55,80.24Z';
---

<svg class:list={['app-icon', className]} viewBox="0 0 108 108" width={size} height={size} aria-hidden="true">
  <defs>
    <clipPath id={clipId}><path d={pin} /></clipPath>
  </defs>
  <rect width="108" height="108" rx="26" fill="#262C6B" />
  <path d={pin} fill="#000" fill-opacity="0.18" transform="translate(0,1.5)" />
  <path d={pin} fill="#8CC152" />
  <path clip-path={`url(#${clipId})`} fill="#6A9432" d="M61.78,42.6L46.22,58.15L116.22,128.15L131.78,112.6Z" />
  <path fill="#FFFFFF" d="M54.26,61.37A11,11 0 1 1 65,50.64L64.8,58.94A2.29,2.29 0 0 1 62.56,61.17Z" />
</svg>
