---
import '../styles/accent.css';
import Shell from '../../../lib/ui/Shell.astro';
import { cleanPath } from '../../../lib/paths';
import { base, site } from '../data/site';

interface Props {
  /** Leave out on the home page: it keeps the site title and carries the app's structured data. */
  title?: string;
  description?: string;
}

const { title = site.title, description = site.description } = Astro.props;
const home = Astro.props.title === undefined;
const canonical = new URL(cleanPath(Astro.url.pathname), Astro.site).href;
const ogImage = `${base}/og.png`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: site.name,
  operatingSystem: `Android ${site.minAndroid} or later`,
  applicationCategory: 'DeveloperApplication',
  description: site.description,
  url: canonical,
  image: new URL(ogImage, Astro.site).href,
  publisher: { '@type': 'Organization', name: site.publisher, url: site.publisherUrl },
  ...(site.playStoreUrl && { installUrl: site.playStoreUrl }),
};
---

<Shell
  title={title}
  description={description}
  siteName={site.name}
  image={ogImage}
  imageAlt="GPS-Go on a phone: a route drawn around the Champ de Mars in Paris, with the floating joystick."
  favicon={`${base}/favicon.svg`}
  appleTouchIcon={`${base}/apple-touch-icon.png`}
>
  {home && <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  <slot />
</Shell>
