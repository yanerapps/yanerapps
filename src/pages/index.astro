---
import Layout from '../studio/layouts/Layout.astro';
import SwallowSky from '../studio/components/SwallowSky.astro';
import { appIds, appPaths, apps, mailto, studio } from '../apps/registry';

const title = 'Yaner Apps — We make quality apps.';
const description = 'Yaner Apps makes quality apps. Maker of GPS-Go, a no-root location simulator.';
// Apps already on Google Play lead, each as a full-width feature; the rest follow in pairs.
const showcased = appIds
  .flatMap((id) => {
    const app = apps[id];
    return 'showcase' in app ? [{ id, ...app, ...app.showcase }] : [];
  })
  .sort((a, b) => Number(!!b.playStoreUrl) - Number(!!a.playStoreUrl));
---

<Layout title={title} description={description}>
  <section class="hero" id="top" aria-labelledby="hero-title">
    <div class="page layout">
      <div class="copy">
        <h1 id="hero-title">We make <em>quality apps.</em></h1>
        <p class="lede">
          An independent software studio. We build a few focused apps and look after each one until it earns its place
          in your day.
        </p>
        <div class="ctas">
          <a class="btn btn-primary" href="#apps">See what we built</a>
          <a class="btn btn-quiet" href="/gps-go">Explore GPS-Go</a>
        </div>
        <p class="meta">Independent · No dark patterns</p>
      </div>
      <SwallowSky inscription="Ride the Wind" />
    </div>
  </section>

  <section class="section" id="manifesto" aria-labelledby="manifesto-title">
    <div class="page">
      <header class="section-head">
        <p class="kicker reveal">01 · Manifesto</p>
        <h2 class="reveal" id="manifesto-title">Built one beakful at a time.</h2>
      </header>
      <div class="manifesto">
        <p class="origin reveal">
          <span class="cjk" lang="zh">燕儿</span> (Yaner) means &ldquo;little swallow.&rdquo;
        </p>
        <div class="manifesto-body">
          <p class="reveal">
            A swallow builds its nest one beakful of earth at a time &mdash; patiently, deliberately, and exactly where
            it means to live. We build software the same way.
          </p>
          <p class="reveal">
            Zero dark patterns. Zero synthetic urgency. Small and focused is our strength: each tool cared for until it
            deserves to exist.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="apps" aria-labelledby="apps-title">
    <div class="page">
      <header class="section-head">
        <p class="kicker reveal">02 · Apps</p>
        <h2 class="reveal" id="apps-title">Small tools, cared for.</h2>
      </header>
      <div class="apps">
        {
          showcased.map((app) => (
            <article class:list={['app panel reveal', { 'app-feature': app.playStoreUrl }]}>
              <div class="app-head">
                <img class="app-icon" src={app.icon} alt="" width="56" height="56" />
                <div>
                  <h3>{app.name}</h3>
                  <p class="app-tagline">{app.tagline}</p>
                </div>
              </div>
              <p class="app-summary">{app.summary}</p>
              <ul class="app-highlights">
                {app.highlights.map((h) => (
                  <li>{h}</li>
                ))}
              </ul>
              <div class="ctas">
                {app.id === 'gps-go' ? (
                  <a class="btn btn-primary" href={appPaths(app.id).home}>Explore {app.name}</a>
                ) : (
                  <span class="coming-soon">Coming soon to Google Play</span>
                )}
                {app.playStoreUrl && (
                  <a class="btn btn-quiet" href={app.playStoreUrl} rel="noopener">Get it on Google Play</a>
                )}
              </div>
              <p class="app-docs">
                <a href={appPaths(app.id).privacy} aria-label={`${app.name} privacy policy`}>Privacy policy</a>
                <a href={appPaths(app.id).support} aria-label={`${app.name} support`}>Support</a>
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="closing" id="contact" aria-labelledby="contact-title">
    <div class="page">
      <div class="band panel reveal">
        <div class="text">
          <h2 id="contact-title">Questions, feedback or support?</h2>
          <p>
            Write to <a href={mailto()}>{studio.email}</a>. The <a href="/support">support page</a> lists what to include in
            a bug report.
          </p>
        </div>
        <a class="btn btn-primary" href={mailto()}>Email us</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero {
    padding-top: calc(var(--header-h) + clamp(2.5rem, 7vw, 5rem));
    padding-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
  }

  /* background-clip: text paints only inside the box; the padding keeps descenders in it. */
  h1 {
    padding-bottom: 0.1em;
    font-size: clamp(2.75rem, 6vw, 4.5rem);
    background: linear-gradient(var(--heading-from) 45%, var(--heading-to));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  h1 em {
    display: block;
    font-style: normal;
    background: none;
    -webkit-text-fill-color: var(--accent);
  }

  .lede {
    margin-top: 18px;
  }

  /* A status, not a disabled button: set like the mono labels, quieter than the actions it stands in for. */
  .coming-soon {
    font: 12.5px/20px var(--mono);
    letter-spacing: 0.5px;
    color: var(--dim);
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .meta {
    margin-top: 20px;
    font-size: 13px;
    color: var(--dim);
  }

  .manifesto {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(1.5rem, 5vw, 4rem);
    align-items: start;
  }

  .origin {
    font-size: var(--step-2);
    font-weight: 600;
    color: var(--text);
  }

  .cjk {
    font-family: var(--cjk-sans);
    color: var(--accent);
  }

  .manifesto-body {
    display: grid;
    gap: 1rem;
    max-width: var(--measure);
    color: var(--muted);
    font-size: var(--step-1);
  }

  .apps {
    display: grid;
    gap: 16px;
  }

  .app {
    display: grid;
    grid-template-areas: 'head' 'summary' 'highlights' 'ctas' 'docs';
    /* Paired cards keep their actions on one line whatever the length of their lists. */
    grid-template-rows: auto auto 1fr auto auto;
    gap: 16px;
    padding: clamp(20px, 3vw, 28px);
  }

  /* shortcut: an odd number of unreleased apps leaves the last one half-width; span it if that ever looks wrong. */
  @media (min-width: 900px) {
    .apps {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    /* A feature (or a lone card) spans the row and spreads into two columns: the app on the left, what it does on the right. */
    .app-feature,
    .app:only-child {
      grid-column: 1 / -1;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-rows: none;
      grid-template-areas: 'head highlights' 'summary highlights' 'ctas highlights' 'docs highlights';
      column-gap: clamp(2rem, 5vw, 4rem);
      align-content: start;
    }

    .app-feature .app-highlights,
    .app:only-child .app-highlights {
      align-self: center;
    }
  }

  .app-head {
    grid-area: head;
  }

  .app-summary {
    grid-area: summary;
  }

  .app-highlights {
    grid-area: highlights;
    align-self: start;
  }

  .app .ctas {
    grid-area: ctas;
  }

  .app-head {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .app-icon {
    border-radius: 14px;
  }

  .app h3 {
    font-size: var(--step-2);
  }

  .app-tagline {
    color: var(--dim);
    font-size: var(--step--1);
  }

  .app-summary {
    color: var(--muted);
  }

  .app-highlights {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--muted);
    font-size: var(--step--1);
  }

  .app-highlights li {
    position: relative;
    padding-left: 1.25rem;
  }

  .app-highlights li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
  }

  .app .ctas {
    margin-top: 4px;
  }

  .app-docs {
    grid-area: docs;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
    font-size: var(--step--1);
  }

  .app-docs a {
    color: var(--muted);
  }

  .app-docs a:hover {
    color: var(--text);
  }

  .closing {
    padding-block: calc(var(--section-space) / 2) var(--section-space);
  }

  .band {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 20px 24px;
    padding: clamp(20px, 4vw, 32px);
  }

  .band h2 {
    font-size: clamp(1.25rem, 2.6vw, 1.625rem);
    letter-spacing: -0.02em;
  }

  .band p {
    margin-top: 4px;
    color: var(--muted);
    font-size: var(--step--1);
  }

  @media (max-width: 900px) {
    .layout,
    .manifesto {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 640px) {
    .band {
      grid-template-columns: minmax(0, 1fr);
    }

    .band > .btn {
      justify-self: start;
    }
  }
</style>
