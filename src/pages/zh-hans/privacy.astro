const title = '隐私 — Yaner Apps';
const description = 'Yaner Apps 各应用的隐私政策。';
---

<Layout title={title} description={description}>
  <div class="prose">
    <div class="prose-header">
      <h1>隐私</h1>
      <p class="lede">Yaner Apps 的每个应用都有各自的隐私政策。</p>
    </div>

    <ul>
      <li>
        <a href="/zh-hans/gps-go/privacy"><strong>GPS-Go</strong></a>——免 root 的安卓定位模拟工具
      </li>
      <li>
        <a href="/zh-hans/pingdeck/privacy"><strong>PingDeck</strong></a>——同时 ping 大量主机的安卓工具
      </li>
    </ul>

    <p>
      隐私相关问题请写信至 <a href="mailto:yanerapps@gmail.com">yanerapps@gmail.com</a>
    </p>
  </div>
</Layout>
