---
import Layout from '../studio/layouts/Layout.astro';
import { mailto, studio } from '../apps/registry';

const title = 'Privacy — Yaner Apps';
const description = 'Privacy policies for apps by Yaner Apps.';
---

<Layout title={title} description={description}>
  <div class="prose">
    <div class="prose-header">
      <h1>Privacy</h1>
      <p class="lede">Each Yaner Apps app has its own privacy policy.</p>
    </div>

    <ul>
      <li>
        <a href="/gps-go/privacy"><strong>GPS-Go</strong></a> &mdash; no-root location simulator for Android
      </li>
      <li>
        <a href="/pingdeck/privacy"><strong>PingDeck</strong></a> &mdash; pings many hosts at once, for Android
      </li>
    </ul>

    <p>
      Questions about privacy: <a href={mailto()}>{studio.email}</a>
    </p>
  </div>
</Layout>
