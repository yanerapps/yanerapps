---
import Layout from '../studio/layouts/Layout.astro';
import { appIds, appPaths, apps, mailto, studio } from '../apps/registry';

const title = 'Privacy — Yaner Apps';
const description = 'Privacy policies for apps by Yaner Apps.';
---

<Layout title={title} description={description}>
  <div class="prose">
    <div class="prose-header">
      <h1>Privacy</h1>
      <p class="lede">Each Yaner Apps app has its own privacy policy.</p>
    </div>

    <ul class="app-links">
      {
        appIds.map((id) => (
          <li>
            <a class="app-link" href={appPaths(id).privacy}><strong>{apps[id].name}</strong><span>{apps[id].blurb}</span></a>
          </li>
        ))
      }
    </ul>

    <p>
      Questions about privacy: <a href={mailto()}>{studio.email}</a>
    </p>
  </div>
</Layout>

